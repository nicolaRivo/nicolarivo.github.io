<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Nicola Rivosecchi</title>
  <meta name="description" content="{{ description }}">
  {#- Every page rendered by this layout is noindex until cutover. Remove in the cutover task, not before. #}
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/sound/css/tokens.css">
  <style>
    body {
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
      background-color: var(--color-bg);
      color: var(--color-text);
    }
    .container {
      width: 90%;
      max-width: var(--max-content-width);
      margin: 0 auto;
      padding: 0 var(--space-10);
    }
    .skip-link {
      position: absolute;
      left: var(--space-10);
      top: -4rem;
      padding: var(--space-05) var(--space-10);
      background-color: var(--color-text);
      color: var(--color-bg);
    }
    .skip-link:focus { top: var(--space-10); }
    .site-header { padding: var(--space-20) 0 var(--space-10); }
    .site-name {
      font-family: var(--font-display);
      font-size: var(--font-size-logo);
      font-weight: var(--font-weight-thin);
      letter-spacing: var(--letter-spacing-logo);
      text-transform: uppercase;
      margin: 0;
    }
    main { padding: var(--section-spacing) 0 0; }
    h1, h2, h3, h4, h5 {
      margin: 0 0 var(--text-spacing);
      line-height: var(--line-height-heading);
      font-weight: var(--font-weight-thin);
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing-heading);
      overflow-wrap: anywhere;
    }
    h1 { font-size: var(--font-size-h2); }
    a { color: var(--color-primary); }
    a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
    .site-footer {
      background-color: var(--color-dark);
      margin-top: var(--section-spacing);
      padding: var(--space-40) 0 var(--space-20);
      color: var(--text-color-secondary);
    }
    .site-footer p { margin: 0; }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container">
      <p class="site-name">Nicola Rivosecchi</p>
    </div>
  </header>
  <main id="main">
    <div class="container">
{{ content | safe }}
    </div>
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>Nicola Rivosecchi</p>
    </div>
  </footer>
</body>
</html>
