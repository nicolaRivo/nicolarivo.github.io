{#-
  One credit from the `work` collection. Expects `credit` in scope.
  Editorial fields that are still "TODO" (or empty) render as nothing.
  The poster is a local WebP (npm run posters); no third-party host is contacted
  on load. cards.js injects the iframe on click. Without JS the play control is
  a plain outbound link inside <noscript>.
-#}
{%- set videoId = credit.data.youtube_id %}
{%- set title = credit.data.title %}
{%- set year = credit.data.year %}
{%- set typeLabel = workTypes[credit.data.type] %}
{%- set creditLine = (credit.data.credit_line or "") | trim %}
{%- set showYear = year and year != "TODO" %}
{%- set showCreditLine = creditLine and creditLine != "TODO" %}
{#- The id attribute is deliberately not named after the video host: the built
    page must contain no third-party host name. cards.js reads data-video-id. -#}
<article class="card" data-video-id="{{ videoId }}" data-title="{{ title }}">
  <div class="card-media">
    {%- if posters[videoId] %}
    <img class="card-thumb" src="/sound/img/posters/{{ videoId }}.webp" alt="Thumbnail of the video “{{ title }}”" width="640" height="360" loading="lazy" decoding="async">
    {%- endif %}
    <button class="card-play" type="button" hidden aria-label="Play video: {{ title }}"><span class="card-play-icon" aria-hidden="true"></span></button>
    <noscript><a class="card-play" href="https://youtu.be/{{ videoId }}" aria-label="Watch on YouTube: {{ title }}"><span class="card-play-icon" aria-hidden="true"></span></a></noscript>
  </div>
  <div class="card-body">
    <h2 class="card-title">{{ title }}</h2>
    {%- if showYear or typeLabel %}
    <p class="card-meta">{% if showYear %}<span class="card-year">{{ year }}</span>{% endif %}{% if typeLabel %}<span class="card-type">{{ typeLabel }}</span>{% endif %}</p>
    {%- endif %}
    {%- if showCreditLine %}
    <p class="card-credit">{{ creditLine }}</p>
    {%- endif %}
  </div>
</article>
